---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { profile } from '../data/profile';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${profile.name} — Software y sistemas de gestión`,
  description = profile.description,
} = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1426" />
    <meta name="author" content={profile.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonical && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:url" content={canonical} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <canvas class="ambient-canvas" aria-hidden="true"></canvas>
    <div class="reading-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <header class="site-header container">
      <a class="brand" href="/" aria-label="Matías De Sousa, inicio">
        mds<span>.</span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="/#proyectos">Proyectos</a>
        <a href="/#sobre-mi">Sobre mí</a>
        <a class="nav-contact" href="/#contacto">
          Hablemos
        </a>
      </nav>
      <button class="motion-toggle" type="button" hidden aria-pressed="false">
        Pausar efectos
      </button>
    </header>
    <slot />
    <footer class="site-footer container">
      <a class="brand" href="/" aria-label="Volver al inicio">
        mds<span>.</span>
      </a>
      <p>Matías De Sousa · Desarrollo de software</p>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">
        GitHub <span class="sr-only">(abre en otra pestaña)</span>
      </a>
    </footer>
    <script>
      import { initializeMotion } from '../scripts/motion';
      initializeMotion();
    </script>
  </body>
</html>
