---
import { getUI, type Locale } from '../i18n/ui';
interface Props {
  email: string;
  locale?: Locale;
}
const { email, locale = 'es' } = Astro.props;
const t = getUI(locale);
---

<div class="contact-email">
  <button
    id="contact-email-link"
    class="contact-email-action"
    type="button"
    aria-label={`${t.copyEmail}: ${email}`}
    title={t.copyEmail}
    data-copy-email={email}
    data-label={`${t.copyEmail}: ${email}`}
    data-hint={t.copyEmail}
    data-success={t.copied}
    data-failure={t.copyFailed}
  >
    {email}
  </button>
  <span
    class="email-copy-status"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></span>
</div>
<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-copy-email]')
    .forEach((email) => {
      const status =
        email.parentElement!.querySelector<HTMLElement>('.email-copy-status')!;
      let reset: ReturnType<typeof setTimeout>;
      let busy = false;
      email.addEventListener('click', async () => {
        if (busy) return;
        busy = true;
        clearTimeout(reset);
        delete email.dataset.copied;
        status.textContent = '';
        try {
          await navigator.clipboard.writeText(email.dataset.copyEmail!);
          email.dataset.copied = 'true';
          status.textContent = email.dataset.success!;
        } catch {
          const range = document.createRange();
          range.selectNodeContents(email);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
          status.textContent = email.dataset.failure!;
        } finally {
          busy = false;
        }
        reset = setTimeout(() => {
          delete email.dataset.copied;
          status.textContent = '';
        }, 4000);
      });
    });
</script>
