---
import type { TourStop } from '../data/walkthroughs';
import { getUI, type Locale } from '../i18n/ui';
interface Props {
  stops: TourStop[];
  locale?: Locale;
}
const { stops, locale = 'es' } = Astro.props;
const t = getUI(locale);
---

<dialog
  id="page-tour"
  class="page-tour"
  aria-labelledby="tour-title"
  aria-describedby="tour-message"
  data-stops={JSON.stringify(stops)}
>
  <div class="tour-spotlight" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
    <i></i>
  </div>
  <svg class="tour-connector" aria-hidden="true">
    <path pathLength="1"></path>
    <circle r="2.5"></circle>
  </svg>
  <div class="tour-card">
    <div class="tour-countdown" aria-hidden="true">
      <span class="tour-countdown-fill"></span>
    </div>
    <div class="tour-card-top">
      <div class="tour-label">
        <span class="tour-beacon" aria-hidden="true"></span>
        <span class="eyebrow">{t.tourLabel}</span>
      </div>
      <button class="tour-close" type="button" aria-label={t.closeTour}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="m4 4 8 8M12 4l-8 8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
    <div class="tour-copy" aria-live="polite" aria-atomic="true">
      <h2 id="tour-title"></h2>
      <p id="tour-message"></p>
    </div>
    <div class="tour-link-slot">
      <a class="tour-follow" hidden></a>
    </div>
    <div class="tour-controls">
      <button class="tour-play" type="button" aria-pressed="true">
        {t.pause}
      </button>
      <div class="tour-arrows">
        <button class="tour-previous" type="button" aria-label={t.previousStop}>
          <span aria-hidden="true">←</span>
        </button>
        <button class="tour-forward" type="button" aria-label={t.nextStop}>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
  <div class="tour-navigation">
    <button class="tour-next" type="button">
      {t.next} →
    </button>
  </div>
</dialog>

<script>
  import { initializeWalkthrough } from '../scripts/walkthrough';
  initializeWalkthrough();
</script>
