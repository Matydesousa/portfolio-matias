---
import type { Project } from '../data/projects';
import { getUI, projectPath, type Locale } from '../i18n/ui';
interface Props {
  projects: Project[];
  locale?: Locale;
}
const { projects, locale = 'es' } = Astro.props;
const t = getUI(locale);
---

<section class="project-ribbon container" aria-labelledby="ribbon-title">
  <h2 id="ribbon-title" class="sr-only">
    {t.projects}
  </h2>
  <p id="ribbon-help" class="sr-only" hidden>
    {t.ribbonHelp}
  </p>
  <p id="ribbon-keyboard" class="sr-only" hidden>
    {t.ribbonKeyboard}
  </p>
  <p class="sr-only" data-ribbon-status role="status"></p>
  <div
    class="ribbon-viewport"
    tabindex="0"
    role="group"
    aria-label={t.projects}
  >
    <div class="ribbon-track">
      <div class="ribbon-surface" aria-hidden="true">
        {Array.from({ length: 48 }, (_, index) => (
          <span class="ribbon-segment" data-segment={index}>
            <svg
              class="ribbon-wake"
              viewBox="0 0 40 120"
              preserveAspectRatio="none"
            >
              <g class="wake-stream">
                <path d="M0 -8Q18 -16 40 -8M0 128Q24 136 40 128" />
                <path
                  class="wake-soft"
                  d="M0 5Q24 -2 40 5M0 115Q24 122 40 115"
                />
                <path
                  class="wake-particles"
                  d="M5 -24H15M22 -33H26M28 148H38"
                />
              </g>
              <g class="wake-ion">
                <path d="M0 -8L10 -20L22 -4L30 -16L40 -8M0 128L12 140L24 124L34 136L40 128" />
                <path class="wake-sparks" d="M0 4H40M0 116H40" />
                <path
                  class="wake-particles"
                  d="M5 -32L12 -25M22 -40L26 -36M30 148L38 156"
                />
              </g>
              <g class="wake-filament">
                <path d="M0 -6L12 -18L26 -6L40 -18M0 126L14 138L28 126L40 138" />
                <path
                  class="wake-particles"
                  d="M20 -38V-22M12 -30H28M6 146L14 154M6 154L14 146"
                />
              </g>
            </svg>
            <svg
              class="ribbon-mesh"
              viewBox="0 0 40 120"
              preserveAspectRatio="none"
            >
              <path
                class="ribbon-triangles"
                d="M0 0L40 30L0 60L40 90L0 120M40 0L0 30L40 60L0 90L40 120M0 30H40M0 60H40M0 90H40"
                vector-effect="non-scaling-stroke"
              />
              <path
                class="ribbon-circuit"
                d="M0 24H10L18 42H30L38 24H40M0 84H12L20 66H32L40 84M12 0V12L28 30V54M28 120V102L12 84V60"
                vector-effect="non-scaling-stroke"
              />
              <path
                class="ribbon-midline"
                d="M0 60H40"
                vector-effect="non-scaling-stroke"
              />
              <g class="ribbon-circuit ribbon-nodes">
                <circle cx="28" cy="54" r="1.4" />
                <circle cx="12" cy="60" r="1.4" />
              </g>
            </svg>
          </span>
        ))}
      </div>
      <ul class="ribbon-group">
        {projects.map((project) => (
          <li>
            <a
              class="ribbon-card"
              href={projectPath(project.slug, locale)}
              aria-label={`${t.ribbonOpen} ${project.title}`}
              draggable="false"
            >
              <div class="ribbon-card-top">
                <img
                  src={project.thumbnail}
                  alt=""
                  width="100"
                  height="70"
                  loading="lazy"
                  draggable="false"
                />
                <span aria-hidden="true">{project.number}</span>
              </div>
              <h3>{project.title}</h3>
              <p>{project.stack.slice(0, 3).join(' · ')}</p>
              <span class="ribbon-card-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { initializeProjectRibbon } from '../scripts/project-ribbon';
  initializeProjectRibbon();
</script>

<style>
  .project-ribbon {
    --card-width: 280px;
    --card-height: 192px;
    --ribbon-rgb: 139 185 255;
    --wake-border: 0.27;
    --ribbon-top: #1d304a;
    --ribbon-bottom: #111e34;
    margin-top: 0;
    min-width: 0;
    position: relative;
    z-index: 1;
  }
  .project-ribbon[data-tone='1'] {
    --wake-border: 0.4;
    --ribbon-rgb: 116 201 255;
    --ribbon-top: #74c9ff12;
    --ribbon-bottom: #153c5f1f;
  }
  .project-ribbon[data-tone='2'] {
    --wake-border: 0.72;
    --ribbon-rgb: 255 255 255;
  }
  .ribbon-viewport {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 28px 0;
    position: relative;
    scrollbar-width: thin;
    scrollbar-color: #354b70 transparent;
  }
  .ribbon-viewport:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 16px;
  }
  .ribbon-track {
    width: max-content;
    display: flex;
  }
  .ribbon-group {
    display: flex;
    gap: 104px;
    list-style: none;
    padding: 0 104px 0 0;
    margin: 0;
    flex-shrink: 0;
  }
  .ribbon-group li {
    flex: 0 0 280px;
    width: 280px;
  }
  .ribbon-surface {
    display: none;
  }
  .ribbon-card {
    display: block;
    position: relative;
    min-height: 192px;
    height: 100%;
    padding: 18px;
    background:
      linear-gradient(
        120deg,
        rgb(var(--ribbon-rgb) / var(--face-light, 0.05)),
        transparent 55%
      ),
      linear-gradient(145deg, var(--ribbon-top), var(--ribbon-bottom));
    border: 1px solid rgb(var(--ribbon-rgb) / 0.27);
    border-radius: 16px;
    box-shadow: 0 12px 24px #02081736;
    user-select: none;
    -webkit-user-select: none;
  }
  .ribbon-card:hover {
    border-color: rgb(var(--ribbon-rgb) / 0.7);
  }
  .project-ribbon[data-tone='1'] .ribbon-card {
    border-color: rgb(var(--ribbon-rgb) / 0.4);
    box-shadow: 0 0 14px #74c9ff08;
  }
  .project-ribbon[data-tone='1'] .ribbon-card p {
    color: #d7e7f6;
  }
  .project-ribbon[data-tone='2'] .ribbon-card {
    background: transparent;
    border-color: rgb(var(--ribbon-rgb) / 0.72);
    box-shadow:
      0 0 18px #ffffff10,
      inset 0 0 18px #ffffff08;
  }
  .project-ribbon[data-tone='2'] .ribbon-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 92% 8%, #ffffff12, transparent 65%),
      linear-gradient(
        120deg,
        rgb(255 255 255 / var(--face-light, 0.05)),
        transparent 55%
      );
  }
  .project-ribbon[data-tone='2'] .ribbon-card:hover {
    border-color: #fff;
  }
  .project-ribbon[data-tone='1'] .ribbon-card h3,
  .project-ribbon[data-tone='1'] .ribbon-card p,
  .project-ribbon[data-tone='2'] .ribbon-card h3,
  .project-ribbon[data-tone='2'] .ribbon-card p {
    text-shadow:
      0 1px 4px #071020,
      0 0 8px #071020;
  }
  .ribbon-card:focus-visible {
    outline-offset: -3px;
  }
  .ribbon-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
  }
  .ribbon-card-top img {
    width: 90px;
    height: 63px;
    border-radius: 6px;
  }
  .ribbon-card-top span {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: rgb(var(--ribbon-rgb) / 0.65);
  }
  .ribbon-card h3 {
    font-size: 0.875rem;
    line-height: 1.5;
    padding-right: 12px;
  }
  .ribbon-card p {
    margin-top: 6px;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .ribbon-card-arrow {
    position: absolute;
    bottom: 18px;
    right: 16px;
    font-size: 0.875rem;
    color: rgb(var(--ribbon-rgb));
  }
  .project-ribbon[data-enhanced] .ribbon-viewport {
    overflow: hidden;
    height: var(--ring-height);
    padding: 0;
    cursor: grab;
    touch-action: pinch-zoom;
    perspective: var(--ring-perspective);
    perspective-origin: 50% 50%;
    background: radial-gradient(
      ellipse 40% 8% at 50% 92%,
      #406fab1a,
      transparent
    );
  }
  .project-ribbon[data-dragging] .ribbon-viewport,
  .project-ribbon[data-dragging] .ribbon-card {
    cursor: grabbing;
  }
  .project-ribbon[data-enhanced] .ribbon-track {
    position: absolute;
    left: 50%;
    top: calc(50% - var(--ring-lift));
    width: 0;
    height: 0;
    display: block;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .project-ribbon[data-enhanced] .ribbon-group {
    display: block;
    position: absolute;
    width: 0;
    height: 0;
    padding: 0;
    transform-style: preserve-3d;
  }
  .project-ribbon[data-enhanced] .ribbon-group li {
    position: absolute;
    width: var(--card-width);
    height: var(--card-height);
    margin-left: calc(var(--card-width) / -2);
    margin-top: calc(var(--card-height) / -2);
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }
  .project-ribbon[data-enhanced] .ribbon-card {
    backface-visibility: hidden;
  }
  .project-ribbon[data-enhanced] .ribbon-group li[data-facing='back'] {
    opacity: 0;
    pointer-events: none;
  }
  .project-ribbon[data-projected] .ribbon-viewport {
    perspective: none;
  }
  .project-ribbon[data-projected]
    :is(.ribbon-track, .ribbon-surface, .ribbon-group) {
    transform-style: flat;
  }
  .project-ribbon[data-projected] .ribbon-group {
    z-index: 1;
  }
  .project-ribbon[data-enhanced] .ribbon-surface {
    display: block;
    position: absolute;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    pointer-events: none;
  }
  .ribbon-segment {
    position: absolute;
    width: var(--segment-width);
    height: var(--band-height);
    margin-left: calc(var(--segment-width) / -2);
    margin-top: calc(var(--band-height) / -2);
    border-top: 1px solid rgb(var(--ribbon-rgb) / 0.44);
    border-bottom: 1px solid rgb(var(--ribbon-rgb) / 0.25);
    background: linear-gradient(
      180deg,
      rgb(var(--ribbon-rgb) / 0.12),
      var(--ribbon-bottom) 48%,
      rgb(var(--ribbon-rgb) / 0.16)
    );
  }
  .project-ribbon[data-tone='2'] .ribbon-segment {
    background: transparent;
    opacity: var(--band-light, 1);
    border-top-color: #ffffffa6;
    border-bottom-color: #ffffff80;
    border-left: 1px solid #ffffff1f;
    box-shadow:
      0 -3px 12px #ffffff08,
      inset 0 1px 8px #ffffff09;
  }
  .project-ribbon[data-tone='2'] .ribbon-segment::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, #ffffff0f, transparent 48%, #ffffff14);
  }
  .project-ribbon[data-tone='1'] .ribbon-segment {
    background: linear-gradient(
      180deg,
      rgb(var(--ribbon-rgb) / 0.06),
      transparent 48%,
      rgb(var(--ribbon-rgb) / 0.08)
    );
    opacity: var(--band-light, 1);
  }
  .ribbon-mesh {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgb(var(--ribbon-rgb));
    stroke-width: 0.65px;
    pointer-events: none;
  }
  .ribbon-wake {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgb(var(--ribbon-rgb));
    overflow: visible;
    stroke-width: 2.5;
    opacity: calc(var(--wake-strength, 0) * var(--wake-light, 0));
    transform: scaleX(var(--wake-direction, 1)) scaleY(var(--wake-expansion, 1));
    pointer-events: none;
    filter: drop-shadow(0 0 5px rgb(var(--ribbon-rgb) / 0.9));
  }
  .project-ribbon[data-enhanced][data-wake] .ribbon-card {
    border-color: rgb(
      var(--ribbon-rgb) /
        calc(
          var(--wake-border) + (1 - var(--wake-border)) * var(--wake-strength) *
            0.9
        )
    );
    box-shadow:
      0 0 24px rgb(var(--ribbon-rgb) / calc(var(--wake-strength) * 0.3)),
      inset 0 0 16px rgb(var(--ribbon-rgb) / calc(var(--wake-strength) * 0.08));
  }
  .project-ribbon[data-enhanced][data-wake] .ribbon-wake {
    display: block;
  }
  .ribbon-wake path {
    vector-effect: non-scaling-stroke;
  }
  .ribbon-wake g {
    display: none;
  }
  .project-ribbon[data-tone='0'] .wake-stream,
  .project-ribbon[data-tone='1'] .wake-ion,
  .project-ribbon[data-tone='2'] .wake-filament {
    display: block;
  }
  .wake-soft {
    opacity: 0.6;
    stroke-width: 4;
  }
  .wake-sparks,
  .wake-particles {
    stroke-linecap: round;
    stroke-width: 2;
  }
  .wake-filament {
    stroke-width: 1.75;
  }
  .ribbon-triangles,
  .ribbon-circuit,
  .ribbon-midline {
    display: none;
  }
  .ribbon-nodes {
    fill: rgb(var(--ribbon-rgb));
    stroke: none;
  }
  .project-ribbon[data-tone='0'] .ribbon-mesh {
    display: block;
    opacity: 0.06;
  }
  .project-ribbon[data-tone='0'] .ribbon-midline,
  .project-ribbon[data-tone='1'] .ribbon-triangles,
  .project-ribbon[data-tone='2'] .ribbon-circuit {
    display: block;
  }
  .project-ribbon[data-tone='1'] .ribbon-mesh {
    display: block;
    opacity: 0.14;
  }
  .project-ribbon[data-tone='2'] .ribbon-mesh {
    display: block;
    opacity: 0.36;
  }
  /* The same five native links form a flat, compact list when effects are off. */
  .project-ribbon:not([data-enhanced]) .ribbon-viewport {
    overflow: visible;
    padding: 16px 0;
    perspective: none;
    cursor: auto;
  }
  .project-ribbon:not([data-enhanced]) .ribbon-track {
    width: 100%;
    display: block;
  }
  .project-ribbon:not([data-enhanced]) .ribbon-group {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
    padding: 0;
  }
  .project-ribbon:not([data-enhanced]) .ribbon-group li {
    width: auto;
    min-width: 0;
  }
  .project-ribbon:not([data-enhanced]) .ribbon-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    padding: 12px 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    box-shadow: none;
    user-select: auto;
    -webkit-user-select: auto;
  }
  .project-ribbon:not([data-enhanced]) .ribbon-card::before,
  .project-ribbon:not([data-enhanced]) .ribbon-card-top,
  .project-ribbon:not([data-enhanced]) .ribbon-card p {
    display: none;
  }
  .project-ribbon:not([data-enhanced]) .ribbon-card h3 {
    padding: 0;
    color: var(--text);
    text-shadow: none;
  }
  .project-ribbon:not([data-enhanced]) .ribbon-card:hover h3 {
    color: var(--accent);
  }
  .project-ribbon:not([data-enhanced]) .ribbon-card-arrow {
    position: static;
    color: var(--accent);
    flex-shrink: 0;
  }
  .project-ribbon:not([data-enhanced]) .ribbon-card:focus-visible {
    outline-offset: 3px;
  }
  @media (max-width: 700px) {
    .project-ribbon {
      --card-width: clamp(136px, 38vw, 168px);
    }
    .ribbon-group li {
      width: var(--card-width);
      flex-basis: var(--card-width);
    }
    .project-ribbon:not([data-enhanced]) .ribbon-group {
      grid-template-columns: 1fr;
    }
    .project-ribbon[data-enhanced] .ribbon-viewport {
      /* Extra clearance for the upper/lower edge while dragging or rotating. */
      height: calc(var(--ring-height) + 24px);
    }
    .project-ribbon[data-enhanced] .ribbon-card {
      min-height: 148px;
      padding: 12px 12px 28px;
      border-radius: 12px;
    }
    .project-ribbon[data-enhanced] .ribbon-card-top {
      gap: 6px;
      margin-bottom: 8px;
    }
    .project-ribbon[data-enhanced] .ribbon-card-top img {
      width: 58px;
      height: 41px;
    }
    .project-ribbon[data-enhanced] .ribbon-card h3 {
      font-size: 0.75rem;
      line-height: 1.4;
      padding-right: 0;
    }
    .project-ribbon[data-enhanced] .ribbon-card p {
      font-size: 0.625rem;
      line-height: 1.4;
    }
    .project-ribbon[data-enhanced] .ribbon-card-arrow {
      bottom: 10px;
      right: 12px;
    }
  }
</style>
